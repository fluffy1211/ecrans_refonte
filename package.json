{
  "name": "ecrans-pas-tout-le-temps",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run images:prepare && astro build && node scripts/publish-images.mjs",
    "preview": "npm run build && wrangler dev",
    "astro": "astro",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "lint": "eslint src --ext .ts,.astro",
    "lint:fix": "eslint src --ext .ts,.astro --fix",
    "format": "prettier --write src",
    "images:prepare": "node scripts/optimize-images.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.*",
    "test:build": "node tests/verify-build.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/tailwind": "^5.1.4",
    "@playform/compress": "^0.2.3",
    "astro": "^5.7.1",
    "astro-critters": "^2.2.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "astro-eslint-parser": "^1.3.2",
    "eslint": "^9.21.0",
    "eslint-plugin-astro": "^1.4.0",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript-eslint": "^8.21.0",
    "wrangler": "^4.90.0"
  }
}
