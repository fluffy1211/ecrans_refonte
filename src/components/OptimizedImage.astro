---
import { imageSources } from '@lib/images.mjs';

interface Props {
  src: string;
  alt: string;
  width?: number | string;
  height?: number | string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  loading = 'lazy',
  fetchpriority,
  class: className,
} = Astro.props;

const sources = imageSources(src);
---

<picture>
  {sources.map(({ src, type }) => <source srcset={src} type={type} />)}
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    fetchpriority={fetchpriority}
    class={className}
  />
</picture>
